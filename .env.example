YANDEX_CLIENT_ID=
# Needed only for refresh flows supported by your Yandex application.
YANDEX_CLIENT_SECRET=
YANDEX_REDIRECT_URI=http://127.0.0.1:8765/callback
YANDEX_TOKEN_FILE=/data/tokens.json
YANDEX_READ_ONLY=true
HOST=127.0.0.1
PORT=3000
MCP_BEARER_TOKEN=
MCP_PUBLIC_URL=https://your-server.example
YANDEX_TOKEN_ENCRYPTION_KEY_FILE=/secrets/token-key
# Optional pre-issued token; do not commit actual values.
YANDEX_ACCESS_TOKEN=
# For MCP OAuth set ALL four fields, otherwise leave them absent (not empty).
# PUBLIC_URL=https://mcp.example.com
# MCP_OAUTH_CLIENTS=[{"clientId":"your-client","redirectUris":["https://client.example.com/callback"]}]
# MCP_OWNER_SECRET=
# MCP_SIGNING_SECRET=
